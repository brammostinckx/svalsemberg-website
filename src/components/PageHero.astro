---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  width?: '4xl' | '5xl' | '6xl';
}
const { eyebrow, title, intro, width = '5xl' } = Astro.props;
const maxW = { '4xl': 'max-w-4xl', '5xl': 'max-w-5xl', '6xl': 'max-w-6xl' }[width];
---
<section class="relative isolate overflow-hidden bg-[#07153b] text-white px-4">
  <div aria-hidden="true" class="absolute inset-0 -z-10 opacity-[0.08] [background-image:radial-gradient(white_1px,transparent_1px)] [background-size:24px_24px] [mask-image:linear-gradient(to_bottom,black_20%,transparent)]"></div>
  <div aria-hidden="true" class="absolute -z-10 -top-48 -right-24 w-[38rem] h-[38rem] rounded-full bg-blue-500/25 blur-3xl"></div>
  <div class={`${maxW} mx-auto pt-14 pb-14 md:pt-20 md:pb-20`}>
    {eyebrow && (
      <div class="hero-item inline-flex items-center gap-2 bg-white/[0.07] border border-white/15 text-yellow-300 text-xs font-semibold px-3 py-1.5 rounded-full mb-5 tracking-wide">
        <span class="w-1.5 h-1.5 rounded-full bg-yellow-400"></span>
        {eyebrow}
      </div>
    )}
    <h1 class="hero-item text-4xl sm:text-5xl md:text-6xl font-extrabold leading-[1.02] tracking-[-0.03em] max-w-3xl" style="animation-delay:80ms">{title}</h1>
    {intro && <p class="hero-item text-blue-100/85 text-lg md:text-xl leading-relaxed max-w-2xl mt-5" style="animation-delay:160ms">{intro}</p>}
    {Astro.slots.has('default') && (
      <div class="hero-item flex flex-wrap gap-3 mt-8" style="animation-delay:240ms">
        <slot />
      </div>
    )}
  </div>
</section>
