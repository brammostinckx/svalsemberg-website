---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Opendeurdag" description="Bezoek Sint-Victor Alsemberg tijdens onze opendeurdag.">

  <PageHero
    eyebrow="Evenement"
    title="Opendeurdag"
    intro="Kom onze school ontdekken op zaterdag 9 mei 2026 van 9u tot 12u."
    width="4xl"
  />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">

      <div class="scroll-reveal bg-yellow-50 border border-yellow-200 rounded-2xl p-6 mb-12 flex gap-4 items-start">
        <div class="bg-[#07153b] rounded-xl w-12 h-12 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <div>
          <div class="font-bold text-[#07153b] mb-1">Zaterdag 9 mei 2026 — 9u tot 12u</div>
          <p class="text-gray-600 text-sm">Brusselsesteenweg 20, 1652 Alsemberg — Gratis, zonder inschrijving</p>
        </div>
      </div>

      <div class="scroll-reveal max-w-3xl text-gray-600 mb-12" style="--d:80ms">
        <span class="eyebrow">Welkom</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b] mb-5">Welkom op onze opendeurdag</h2>
        <p class="leading-relaxed mb-6">Op zaterdag 9 mei 2026 van 9u tot 12u kan je onze school vrijblijvend bezoeken. Ontdek onze studierichtingen, stel vragen aan leerkrachten en leerlingen, en voel de sfeer van Sint-Victor Alsemberg.</p>

        <ul class="divide-y divide-gray-200 border-y border-gray-200">
          {[
            'Gratis toegang, geen inschrijving nodig',
            'Alle studierichtingen worden voorgesteld',
            'Rondleiding door leerlingen',
            'Infostand voor ouders',
          ].map(item => (
            <li class="flex items-center gap-3 py-3">
              <svg class="w-4 h-4 text-yellow-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="scroll-reveal bg-[#07153b] text-white rounded-2xl p-6 md:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-blue-100/80 font-medium">Vragen over de opendeurdag?</p>
        <a href="/contact" class="btn btn-primary">
          Contacteer ons
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>

    </div>
  </section>

</Layout>
