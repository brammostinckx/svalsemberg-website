---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const pijl = "M13 7l5 5m0 0l-5 5m5-5H6";
---
<Layout title="Google Classroom & Gmail" description="Aanmelden bij Google Classroom en Gmail van Sint-Victor Alsemberg.">

  <PageHero
    eyebrow="Chromebookproject"
    title="Google Classroom & Gmail"
    intro="Meld je aan met je schoolaccount om toegang te krijgen tot je lessen en berichten."
    width="4xl"
  />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="max-w-3xl">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

          <!-- Google Classroom -->
          <a href="https://classroom.google.com" target="_blank" rel="noopener"
            class="scroll-reveal group bg-white rounded-2xl border border-gray-200 shadow-card p-7 md:p-8 flex flex-col transition-[translate,box-shadow,border-color] duration-300 ease-fluid hover:-translate-y-1 hover:shadow-card-hover hover:border-transparent">
            <div class="w-14 h-14 mb-6">
              <svg viewBox="0 0 48 48" class="w-14 h-14" aria-hidden="true">
                <rect width="48" height="48" rx="8" fill="#0F9D58"/>
                <rect x="10" y="14" width="28" height="20" rx="2" fill="white" opacity="0.9"/>
                <rect x="14" y="18" width="20" height="2.5" rx="1" fill="#0F9D58"/>
                <rect x="14" y="22.5" width="14" height="2" rx="1" fill="#0F9D58" opacity="0.6"/>
                <rect x="14" y="26" width="16" height="2" rx="1" fill="#0F9D58" opacity="0.6"/>
                <circle cx="38" cy="34" r="7" fill="#0F9D58"/>
                <path d="M35 34l2 2 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>
            <h2 class="font-bold text-[#07153b] text-xl mb-2">Google Classroom</h2>
            <p class="text-gray-500 text-sm leading-relaxed mb-6">Taken, opdrachten en lesmateriaal van je leerkrachten.</p>
            <span class="btn btn-navy w-full mt-auto group-hover:bg-[#13265e]">
              Aanmelden
              <svg class="group-hover:translate-x-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={pijl}/></svg>
            </span>
          </a>

          <!-- Gmail -->
          <a href="https://www.gmail.com" target="_blank" rel="noopener"
            class="scroll-reveal group bg-white rounded-2xl border border-gray-200 shadow-card p-7 md:p-8 flex flex-col transition-[translate,box-shadow,border-color] duration-300 ease-fluid hover:-translate-y-1 hover:shadow-card-hover hover:border-transparent" style="--d:80ms">
            <div class="w-14 h-14 mb-6">
              <svg viewBox="0 0 48 48" class="w-14 h-14" aria-hidden="true">
                <rect width="48" height="48" rx="8" fill="#EA4335"/>
                <path d="M10 16h28v16a2 2 0 01-2 2H12a2 2 0 01-2-2V16z" fill="white" opacity="0.95"/>
                <path d="M10 16l14 10 14-10" stroke="#EA4335" stroke-width="2" fill="none" stroke-linecap="round"/>
              </svg>
            </div>
            <h2 class="font-bold text-[#07153b] text-xl mb-2">Gmail</h2>
            <p class="text-gray-500 text-sm leading-relaxed mb-6">Je schoolmailbox voor externe communicatie buiten de school.</p>
            <span class="btn btn-navy w-full mt-auto group-hover:bg-[#13265e]">
              Aanmelden
              <svg class="group-hover:translate-x-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={pijl}/></svg>
            </span>
          </a>

        </div>

        <div class="scroll-reveal mt-8 bg-blue-50 border border-blue-100 rounded-2xl p-6 flex items-start gap-4" style="--d:160ms">
          <div class="bg-[#07153b] rounded-xl w-10 h-10 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">Meld je aan met je <strong class="text-[#07153b]">schoolaccount</strong> — dit is hetzelfde account als je Smartschool-login (<span class="font-mono text-xs bg-white border border-gray-200 rounded px-1.5 py-0.5 break-all">voornaamachternaam@sintvictor.be</span>).</p>
        </div>

        <div class="mt-12">
          <a href="/chromebookproject" class="group inline-flex items-center gap-2 text-[#07153b] font-semibold text-sm hover:underline underline-offset-4">
            <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Terug naar Chromebookproject
          </a>
        </div>

      </div>
    </div>
  </section>

</Layout>
