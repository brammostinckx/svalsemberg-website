---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
const waarden = [
  { titel: "Rijke ontplooiingskansen", tekst: "We bieden elke leerling individuele ondersteuning en stimuleren positief gedrag, met extra aandacht voor leerlingen met specifieke noden." },
  { titel: "Stevige cognitieve basis", tekst: "Door ambitieus lesgeven bouwen we een stevige kennisbasis. We daag leerlingen uit en ondersteunen hen waar nodig." },
  { titel: "Welbevinden centraal", tekst: "Een positief klimaat waar leerlingen zichzelf kunnen zijn, hun eigenheid ontdekken en met plezier naar school komen." },
  { titel: "Actieve betrokkenheid", tekst: "Leerlingen, ouders en leerkrachten werken samen. Open communicatie en gezamenlijk eigenaarschap staan centraal." },
  { titel: "Duurzaamheid & gezondheid", tekst: "Oog voor energie-efficiëntie, een gezonde leefomgeving en bewust samenleven. Vandaag bouwen aan de wereld van morgen." },
  { titel: "Katholieke traditie", tekst: "Verbonden met de erfenis van Broeder Victor Scheppers: mildheid, nabijheid en aandacht voor de meest kwetsbare leerlingen." },
];
---
<Layout title="Onze school" description="Meer over Sint-Victor Alsemberg: visie, missie en schoolteam.">

  <PageHero
    eyebrow="Sint-Victor Alsemberg"
    title="Onze school"
    intro="Meer dan 150 jaar geleden gesticht door Victor Scheppers. Vandaag nog even warm en gedreven."
    width="5xl"
  />

  <!-- Missie & Visie -->
  <section id="visie" class="py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">

      <!-- Tekst links + missie/visie rechts -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start mb-12">
        <div class="scroll-reveal">
          <span class="eyebrow">Visie & missie</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b] mb-6">Wie zijn wij?</h2>
          <p class="text-gray-600 mb-4 leading-relaxed">
            Sint-Victor Alsemberg is een katholieke Nederlandstalige school die een brede algemene vorming aanbiedt. We bereiden leerlingen voor op het hoger onderwijs, maar hebben ook oog voor hun persoonlijke groei en welzijn.
          </p>
          <p class="text-gray-600 mb-4 leading-relaxed">
            We willen een leeromgeving creëren waar leerlingen kritisch leren denken, verantwoordelijk leren handelen en actief bijdragen aan de samenleving.
          </p>
          <p class="text-gray-600 mb-6 leading-relaxed">
            Alle jongeren moeten zich goed voelen bij ons. Daarom investeren we in een positief schoolklimaat, continue professionalisering van ons team en een moderne infrastructuur die 21ste-eeuws onderwijs mogelijk maakt.
          </p>
          <div class="bg-[#07153b] text-white rounded-2xl p-5 mt-2 flex items-center gap-4">
            <img src="/stempel.jpg" alt="Stempel Sint-Victor" class="w-16 h-16 rounded-xl object-contain shrink-0 opacity-90" />
            <div>
              <div class="text-yellow-400 font-bold mb-1 text-sm">Ons motto</div>
              <div class="italic text-white text-lg">"Honor Deo, Labor mihi, Utilitas proximo"</div>
              <div class="text-blue-100/80 text-xs mt-2">Eer aan God &mdash; Arbeid is mijn deel &mdash; Nut voor de naaste</div>
            </div>
          </div>
        </div>
        <div class="flex flex-col gap-6 self-center">
          <div class="scroll-reveal bg-blue-50 rounded-2xl p-6 md:p-7 border border-blue-100">
            <h3 class="font-bold text-[#07153b] text-xl mb-4">Onze missie</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex gap-2"><span class="text-yellow-500 font-bold shrink-0">—</span> Een brede algemene vorming aanbieden voor elke leerling</li>
              <li class="flex gap-2"><span class="text-yellow-500 font-bold shrink-0">—</span> Jongeren degelijk voorbereiden op het hoger onderwijs</li>
              <li class="flex gap-2"><span class="text-yellow-500 font-bold shrink-0">—</span> Elke leerling zich thuis laten voelen op school</li>
              <li class="flex gap-2"><span class="text-yellow-500 font-bold shrink-0">—</span> Een leeromgeving creëren die kritisch en verantwoordelijk denken stimuleert</li>
            </ul>
          </div>
          <div class="scroll-reveal bg-yellow-50 rounded-2xl p-6 md:p-7 border border-yellow-100" style="--d:100ms">
            <h3 class="font-bold text-[#07153b] text-xl mb-4">Onze visie</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex gap-2"><span class="text-yellow-500 font-bold shrink-0">—</span> Rijke ontplooiingskansen voor elke leerling met aandacht en respect</li>
              <li class="flex gap-2"><span class="text-yellow-500 font-bold shrink-0">—</span> Ambitieus lesgeven met een stevige cognitieve basis</li>
              <li class="flex gap-2"><span class="text-yellow-500 font-bold shrink-0">—</span> Actieve betrokkenheid van leerlingen, ouders en leerkrachten</li>
              <li class="flex gap-2"><span class="text-yellow-500 font-bold shrink-0">—</span> Inspiratie door het opvoedingsproject van Broeder Victor Scheppers</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Statistieken — 4 naast elkaar -->
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { n: "600+", label: "Leerlingen" },
          { n: "150+", label: "Jaar traditie" },
          { n: "15+", label: "Richtingen" },
          { n: "100+", label: "Personeelsleden" },
        ].map((s, i) => (
          <div class="scroll-reveal flex flex-col-reverse bg-gray-50 rounded-2xl p-6 border border-gray-200" style={`--d:${i * 80}ms`}>
            <dt class="text-sm text-gray-500 mt-1">{s.label}</dt>
            <dd class="font-display text-4xl font-extrabold tracking-tight text-[#07153b]">{s.n}</dd>
          </div>
        ))}
      </dl>

    </div>
  </section>

  <!-- Victor Scheppers sectie (Onze roots) — voor Onze waarden -->
  <section class="relative isolate overflow-hidden bg-[#07153b] text-white py-16 md:py-24 px-4">
    <div aria-hidden="true" class="absolute -z-10 -top-40 -left-32 w-[36rem] h-[36rem] rounded-full bg-blue-500/20 blur-3xl"></div>
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="scroll-reveal">
          <span class="eyebrow text-yellow-400">Onze roots</span>
          <h2 class="text-3xl md:text-4xl font-extrabold mb-6">Victor Scheppers</h2>
          <p class="text-blue-100/80 leading-relaxed mb-4">
            Al anderhalve eeuw wordt er in Sint-Victor onderwijs verschaft naar de visie van de stichter, Victor Scheppers. Hij kiest — in zijn tijd — voor de opvoeding van de zwakste jongeren. Voortdurende aanwezigheid bij de leerlingen, zelfs meespelen, zijn voorwaarden om orde, discipline en toewijding aan de studie te verkrijgen.
          </p>
          <p class="text-blue-100/80 leading-relaxed mb-4">
            Zijn ultieme doelstellingen van scholing en opvoeding zijn: godsdienstigheid, deugdzaamheid en onbaatzuchtige inzet voor de medemensen. Vorming van het verstand is voor hem slechts één aspect van de persoonlijkheid van jongeren, ook karakter- en gemoedsvorming zijn belangrijk. Strengheid en zachtmoedigheid gaan bij Victor Scheppers hand in hand.
          </p>
          <p class="text-blue-100/80 leading-relaxed mb-4">
            Jongeren moeten zich als één familie voelen: iedereen verdient respect en niemand mag uitgesloten worden. Zwakke en nieuwe leerlingen worden aangemoedigd en ondersteund.
          </p>
          <p class="text-blue-100/80 leading-relaxed mb-8">
            Ons pedagogisch handelen is dan ook geënt op zijn lijfspreuk: <em class="text-white">Honor Deo, Labor mihi, Utilitas proximo</em>. De voortdurend wijzigende maatschappelijke context vereist dat we deze opvoedkundige visie hertalen naar een hedendaagse opdracht:
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/Opvoedingsconcept Scheppersscholen.pdf" target="_blank" rel="noopener" class="btn btn-primary">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Opvoedingsconcept Scheppersscholen
            </a>
          </div>
        </div>
        <div class="scroll-reveal flex flex-col items-center gap-6" style="--d:100ms">
          <img src="/victorscheppers.jpg" alt="Victor Scheppers" class="rounded-2xl w-full max-w-xs shadow-2xl ring-1 ring-white/10 object-cover" />
          <div class="grid grid-cols-1 gap-3 w-full">
          {[
            { titel: "Honor Deo", tekst: "Vanuit onze evangelische inspiratie hanteren wij een hoopvol mensbeeld." },
            { titel: "Labor mihi", tekst: "Onze deskundige inzet en ons sterk inlevingsvermogen bij elk contact met jongeren garanderen een attentvolle betrokkenheid." },
            { titel: "Utilitas proximo", tekst: "Onze verantwoordelijke dienstbaarheid aan kwetsbaar-jonge medemensen én aan de maatschappij als schepping-in-beweging biedt kansen voor élk kind." },
          ].map(p => (
            <div class="bg-white/[0.06] border border-white/10 rounded-2xl p-5">
              <div class="font-bold text-yellow-400 text-sm mb-1">{p.titel}</div>
              <div class="text-blue-100/80 text-sm leading-relaxed">{p.tekst}</div>
            </div>
          ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Waarden -->
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="scroll-reveal mb-10">
        <span class="eyebrow">Waar we voor staan</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b]">Onze waarden</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {waarden.map((w, i) => (
          <div class="scroll-reveal flex gap-5 bg-white border border-gray-200 shadow-card rounded-2xl p-6" style={`--d:${Math.min(i * 60, 400)}ms`}>
            <span class="font-display text-2xl font-extrabold text-yellow-500 leading-none tabular-nums shrink-0">0{i + 1}</span>
            <div>
              <h3 class="font-bold text-[#07153b] mb-1.5">{w.titel}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{w.tekst}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Schoolteam -->
  <section class="pb-16 md:pb-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div id="team" class="scroll-mt-28">
        <div class="scroll-reveal mb-10">
          <span class="eyebrow">Directie</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b]">Schoolteam</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {[
            { naam: "Nele Neyt", rol: "Directeur 1ste graad", email: "directie@sintvictor.be" },
            { naam: "Kevin Swaelens", rol: "Directeur 2de & 3de graad", email: "directie@sintvictor.be" },
          ].map((p, i) => (
            <div class="scroll-reveal bg-white rounded-2xl p-6 shadow-card border border-gray-200 flex items-center gap-5" style={`--d:${i * 100}ms`}>
              <div class="bg-[#07153b] rounded-full w-14 h-14 flex items-center justify-center shrink-0">
                <span class="text-yellow-400 font-extrabold text-lg">{p.naam.split(' ').map((n: string) => n[0]).join('')}</span>
              </div>
              <div>
                <div class="font-bold text-lg text-[#07153b]">{p.naam}</div>
                <div class="text-gray-500 text-sm">{p.rol}</div>
                <a href={`mailto:${p.email}`} class="text-sm font-medium text-[#07153b] hover:underline underline-offset-4">{p.email}</a>
              </div>
            </div>
          ))}
        </div>
        <p class="scroll-reveal text-gray-600 text-sm mt-6 bg-gray-50 border border-gray-200 rounded-2xl p-5">
          Voor een volledig overzicht van ons lerarenkorps en ondersteunend personeel: neem contact op via <a href="mailto:info@sintvictor.be" class="text-[#07153b] font-semibold hover:underline underline-offset-4">info@sintvictor.be</a>.
        </p>
      </div>
    </div>
  </section>

</Layout>
