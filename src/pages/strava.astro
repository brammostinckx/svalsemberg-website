---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Sint-Victor Strava" description="De Strava club van Sint-Victor Alsemberg — recentste ritten en activiteiten.">

  <PageHero eyebrow="Extra" title="Sint-Victor Strava" intro="Volg de activiteiten van onze Strava-club." width="4xl" />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start justify-center">

        <!-- Club info -->
        <div class="scroll-reveal bg-white rounded-2xl border border-gray-200 shadow-card overflow-hidden">
          <div class="px-5 pt-5">
            <span class="block text-yellow-600 text-xs font-bold uppercase tracking-[0.14em]">Club</span>
          </div>
          <div class="p-4">
            <iframe
              allowtransparency
              frameborder="0"
              height="160"
              scrolling="no"
              src="https://www.strava.com/clubs/1106164/latest-rides/e46dcb56e3917397704cf7a39e3528f236835c97?show_rides=false"
              width="300"
              title="Sint-Victor Strava club info"
            ></iframe>
          </div>
        </div>

        <!-- Laatste ritten -->
        <div class="scroll-reveal bg-white rounded-2xl border border-gray-200 shadow-card overflow-hidden" style="--d:100ms">
          <div class="px-5 pt-5">
            <span class="block text-yellow-600 text-xs font-bold uppercase tracking-[0.14em]">Recentste ritten</span>
          </div>
          <div class="p-4">
            <iframe
              allowtransparency
              frameborder="0"
              height="454"
              scrolling="no"
              src="https://www.strava.com/clubs/1106164/latest-rides/e46dcb56e3917397704cf7a39e3528f236835c97?show_rides=true"
              width="300"
              title="Sint-Victor Strava recentste ritten"
            ></iframe>
          </div>
        </div>

      </div>

      <div class="mt-12 text-center scroll-reveal" style="--d:160ms">
        <a href="https://www.strava.com/clubs/1106164" target="_blank" rel="noopener"
          class="btn bg-[#FC4C02] text-white hover:bg-[#e04402]">
          <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
          </svg>
          Bekijk de club op Strava
        </a>
      </div>

    </div>
  </section>

</Layout>
