---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Inschrijvingen" description="Inschrijven bij Sint-Victor Alsemberg voor schooljaar 2026-2027.">

  <PageHero
    eyebrow="Schooljaar 2026-2027"
    title="Inschrijvingen"
    intro="Welkom bij Sint-Victor! Hier vind je alle info over inschrijven voor het nieuwe schooljaar."
    width="5xl"
  />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">

      <!-- 1ste jaar -->
      <div class="mb-20">
        <div class="scroll-reveal mb-10">
          <span class="eyebrow">Eerste jaar</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b] mb-3">1ste jaar 2026-2027</h2>
          <p class="text-gray-600 max-w-2xl leading-relaxed">Inschrijvingen voor het eerste jaar verlopen via het centraal aanmeldingssysteem <strong class="text-gray-800">aanmelden.school</strong>, in samenwerking met andere regionale scholen.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-8">

          <!-- Stap 1 -->
          <div class="scroll-reveal bg-white rounded-2xl shadow-card border border-gray-200 p-6 md:p-7 flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-[#07153b] text-yellow-400 font-extrabold rounded-full w-9 h-9 flex items-center justify-center text-sm shrink-0">1</div>
              <h3 class="text-lg font-bold text-[#07153b]">Informeer je</h3>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-5">Lees de brochure en bezoek onze opendeurdag om het aanbod te ontdekken.</p>
            <div class="mt-auto">
              <a href="/Brochure Aanmelden 2627.pdf" target="_blank" rel="noopener" class="btn btn-primary w-full">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Brochure aanmelden 2026-2027
              </a>
            </div>
          </div>

          <!-- Stap 2 -->
          <div class="scroll-reveal bg-white rounded-2xl shadow-card border border-gray-200 p-6 md:p-7 flex flex-col" style="--d:80ms">
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-[#07153b] text-yellow-400 font-extrabold rounded-full w-9 h-9 flex items-center justify-center text-sm shrink-0">2</div>
              <h3 class="text-lg font-bold text-[#07153b]">Meld je aan</h3>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-5">Aanmelden gebeurt via het centrale platform <strong>aanmelden.school</strong>. Daar geef je je schoolkeuzes in volgorde van voorkeur in.</p>
            <a href="https://www.aanmelden.school" target="_blank" rel="noopener" class="btn btn-navy w-full mt-auto">
              Naar aanmelden.school
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Stap 3 -->
          <div class="scroll-reveal bg-white rounded-2xl shadow-card border border-gray-200 p-6 md:p-7 flex flex-col" style="--d:160ms">
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-[#07153b] text-yellow-400 font-extrabold rounded-full w-9 h-9 flex items-center justify-center text-sm shrink-0">3</div>
              <h3 class="text-lg font-bold text-[#07153b]">Schrijf je in</h3>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">Na de aanmeldingsperiode ontvang je bericht. Daarna kom je je kind effectief inschrijven op school. Breng mee:</p>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex gap-2 items-start">
                <svg class="w-4 h-4 text-yellow-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                Rapport 6de leerjaar
              </li>
              <li class="flex gap-2 items-start">
                <svg class="w-4 h-4 text-yellow-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                CLB-advies (indien van toepassing)
              </li>
              <li class="flex gap-2 items-start">
                <svg class="w-4 h-4 text-yellow-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                Identiteitsdocument kind
              </li>
            </ul>
          </div>
        </div>

        <div class="scroll-reveal bg-blue-50 border border-blue-100 rounded-2xl p-5 md:p-6 flex gap-4 items-start">
          <svg class="w-5 h-5 text-[#07153b] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-sm text-gray-600 leading-relaxed">
            Sint-Victor Alsemberg werkt samen met andere regionale scholen via het gecentraliseerde aanmeldingssysteem. Meer info over de aanmeldingsprocedure en -periodes vind je op <a href="https://www.aanmelden.school" target="_blank" rel="noopener" class="text-[#07153b] font-bold hover:underline underline-offset-4">aanmelden.school</a>.
          </p>
        </div>
      </div>

      <!-- Zij-instromers -->
      <div class="mb-20">
        <div class="scroll-reveal mb-10">
          <span class="eyebrow">Overstappen</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b] mb-3">Zij-instromers (2de&ndash;6de jaar)</h2>
          <p class="text-gray-600 max-w-2xl leading-relaxed">Wil je overstappen van een andere school naar Sint-Victor? Neem dan eerst contact op met ons secretariaat om de mogelijkheden te bespreken.</p>
        </div>

        <div class="scroll-reveal bg-white rounded-2xl shadow-card border border-gray-200 p-6 md:p-8 flex flex-col md:flex-row gap-8 items-start">
          <div class="flex-1">
            <h3 class="text-lg font-bold text-[#07153b] mb-4">Hoe verloopt dit?</h3>
            <ul class="space-y-3 text-sm text-gray-600">
              <li class="flex gap-3 items-start">
                <svg class="w-4 h-4 text-yellow-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                Neem telefonisch of per mail contact op met het secretariaat
              </li>
              <li class="flex gap-3 items-start">
                <svg class="w-4 h-4 text-yellow-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                We bespreken samen of er een geschikte richting beschikbaar is
              </li>
              <li class="flex gap-3 items-start">
                <svg class="w-4 h-4 text-yellow-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                Breng het attest van het vorige schooljaar mee bij de inschrijving
              </li>
              <li class="flex gap-3 items-start">
                <svg class="w-4 h-4 text-yellow-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                Een persoonlijk gesprek is steeds mogelijk
              </li>
            </ul>
          </div>
          <div class="flex flex-col gap-3 shrink-0 w-full md:w-auto">
            <a href="tel:+3223801589" class="btn btn-navy justify-start">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              02 380 15 89
            </a>
            <a href="mailto:info@sintvictor.be" class="btn btn-outline justify-start">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              info@sintvictor.be
            </a>
          </div>
        </div>
      </div>

      <!-- Onderste 3 blokjes -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          {
            titel: "Infobrochure",
            tekst: "Download onze brochure voor schooljaar 2026-2027 met alle praktische info over aanmelden.",
            link: "/Brochure Aanmelden 2627.pdf",
            linkTekst: "Download PDF",
            extern: true,
          },
          {
            titel: "Opendeurdag",
            tekst: "Bezoek onze school op zaterdag 9 mei 2026 van 9u tot 12u. Gratis en zonder afspraak.",
            link: "/contact",
            linkTekst: "Meer info",
            extern: false,
          },
          {
            titel: "Vragen?",
            tekst: "Neem contact op met ons secretariaat via info@sintvictor.be of bel ons op 02 380 15 89.",
            link: "/contact",
            linkTekst: "Contacteer ons",
            extern: false,
          },
        ].map((i, idx) => (
          <a href={i.link} target={i.extern ? "_blank" : undefined} rel={i.extern ? "noopener" : undefined}
            class="scroll-reveal group bg-white rounded-2xl p-6 md:p-7 flex flex-col border border-gray-200 transition-[translate,box-shadow,border-color] duration-300 ease-fluid hover:-translate-y-1 hover:shadow-card-hover hover:border-transparent"
            style={`--d:${idx * 80}ms`}>
            <div class="w-10 h-10 bg-[#07153b]/[0.06] rounded-xl flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-[#07153b]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-[#07153b] mb-2">{i.titel}</h3>
            <p class="text-gray-600 text-sm mb-6 leading-relaxed">{i.tekst}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 text-[#07153b] text-sm font-bold">
              {i.linkTekst}
              <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </span>
          </a>
        ))}
      </div>

    </div>
  </section>

</Layout>
