---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PageCta from '../components/PageCta.astro';
const richtingen = [
  {
    graad: "1ste graad",
    kleur: "bg-blue-50 border-[#07153b]",
    items: ["A-stroom", "B-stroom"]
  },
  {
    graad: "2de graad ASO",
    kleur: "bg-yellow-50 border-[#f5a623]",
    items: ["Economie-Wiskunde", "Humane Wetenschappen", "Wetenschappen", "Talen"]
  },
  {
    graad: "2de graad TSO/BSO",
    kleur: "bg-blue-50 border-[#07153b]",
    items: ["Handel", "Informaticabeheer", "Verzorging"]
  },
  {
    graad: "3de graad ASO",
    kleur: "bg-yellow-50 border-[#f5a623]",
    items: ["Economie-Wiskunde", "Humane Wetenschappen", "Wetenschappen-Wiskunde", "Latijn-Wiskunde"]
  },
  {
    graad: "3de graad TSO/BSO",
    kleur: "bg-blue-50 border-[#07153b]",
    items: ["Boekhouden-Informatica", "Informaticabeheer", "Thuis- en Bejaardenzorg"]
  },
];
---
<Layout title="Studieaanbod" description="Ontdek het volledige studieaanbod van Sint-Victor Alsemberg.">

  <PageHero title="Studieaanbod" intro="Van eerste graad tot zesde jaar — voor elk talent een richting." width="4xl" />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="space-y-6">
        {richtingen.map((r, i) => (
          <div class={`scroll-reveal rounded-2xl border-l-4 p-6 md:p-8 ${r.kleur}`} style={`--d:${Math.min(i * 80, 400)}ms`}>
            <h2 class="text-xl md:text-2xl font-extrabold text-[#07153b] mb-4">{r.graad}</h2>
            <div class="flex flex-wrap gap-2">
              {r.items.map(item => (
                <span class="bg-white text-[#07153b] px-4 py-2 rounded-full text-sm font-medium shadow-card">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PageCta title="Meer weten over een richting?" intro="Plan een bezoek of neem contact op met onze leerlingenbegeleiding.">
    <a href="/contact" class="btn btn-primary">
      Contacteer ons
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
  </PageCta>

</Layout>
