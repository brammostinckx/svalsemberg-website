---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Chromebook opstarten & instellen" description="Stap voor stap de eerste opstart van je Chromebook op Sint-Victor Alsemberg.">

  <PageHero
    eyebrow="Chromebookproject"
    title="Chromebook opstarten & instellen"
    intro="Volg deze stappen om je Chromebook voor de eerste keer correct in te stellen."
    width="4xl"
  />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="max-w-3xl">

        <!-- Voorbereiding -->
        <div class="scroll-reveal bg-yellow-50 border border-yellow-200 rounded-2xl p-6 mb-14 flex items-start gap-4">
          <div class="bg-yellow-400 rounded-xl w-10 h-10 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-[#07153b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <div class="font-bold text-[#07153b] mb-1">Eerst opladen!</div>
            <p class="text-sm text-yellow-800 leading-relaxed">Laad je Chromebook thuis al ongeveer <strong>15 minuten op</strong> voordat je hem voor de eerste keer opstart. Doe dit niet op school.</p>
          </div>
        </div>

        <!-- Stappen -->
        <span class="scroll-reveal eyebrow mb-6">Stap voor stap</span>

        <ol class="relative">

          {[
            {
              stap: "1",
              titel: "Taal instellen",
              tekst: "Wijzig op het eerste scherm de taal naar \"Nederlands (België)\".",
            },
            {
              stap: "2",
              titel: "Bevestigen",
              tekst: "Druk op \"OK\" om de taalinstelling te bevestigen.",
            },
            {
              stap: "3",
              titel: "Chromevox",
              tekst: "Kies \"Nee, doorgaan zonder Chromevox.\" Werd Chromevox per ongeluk geactiveerd? Schakel het uit met Ctrl + Alt + Z.",
            },
            {
              stap: "4",
              titel: "Aan de slag",
              tekst: "Klik op de blauwe knop \"Aan de slag\".",
            },
            {
              stap: "5",
              titel: "Wifi-verbinding",
              tekst: "Kies je wifi-netwerk en geef het wachtwoord in. Op school maakt de Chromebook automatisch verbinding.",
            },
            {
              stap: "6",
              titel: "Voorwaarden aanvaarden",
              tekst: "Vink de optionele vakjes uit indien gewenst en klik op \"Aanvaarden en doorgaan\".",
            },
            {
              stap: "7",
              titel: "Systeemupdates",
              tekst: "Het toestel downloadt en installeert automatisch de nieuwste updates. Dit kan even duren.",
            },
            {
              stap: "8",
              titel: "Inschrijving in schooldomein",
              tekst: "De Chromebook schrijft zich automatisch in op het domein van de school. Klik op \"Klaar\" wanneer dit voltooid is.",
            },
            {
              stap: "9",
              titel: "Aanmelden",
              tekst: "Meld je aan met je Smartschool-gebruikersnaam en -wachtwoord. Na het aanmelden is de installatie volledig afgerond.",
            },
          ].map((s, i, arr) => (
            <li class="scroll-reveal relative grid grid-cols-[auto_1fr] gap-x-5 pb-8 last:pb-0" style={`--d:${Math.min(i * 60, 400)}ms`}>
              {i < arr.length - 1 && <span aria-hidden="true" class="absolute left-[1.125rem] top-11 bottom-1 w-px bg-gray-200"></span>}
              <span class="relative font-display bg-[#07153b] text-yellow-400 font-extrabold text-base rounded-full w-9 h-9 flex items-center justify-center tabular-nums">{s.stap}</span>
              <div class="pt-1.5">
                <h3 class="font-bold text-[#07153b] text-lg leading-snug mb-1">{s.titel}</h3>
                <p class="text-gray-600 leading-relaxed">{s.tekst}</p>
              </div>
            </li>
          ))}

        </ol>

        <!-- Klaar -->
        <div class="scroll-reveal mt-14 relative isolate overflow-hidden bg-[#07153b] text-white rounded-2xl p-8 md:p-10">
          <div aria-hidden="true" class="absolute -z-10 -top-24 -right-16 w-72 h-72 rounded-full bg-blue-500/20 blur-3xl"></div>
          <h2 class="text-2xl font-extrabold mb-2">Alles ingesteld?</h2>
          <p class="text-blue-100/80 mb-6">Leer nu werken met Google Workspace via onze Google Skills site.</p>
          <div class="flex flex-wrap gap-3">
            <a href="https://sites.google.com/vbsasintvictor.be/gwfe-skills/home" target="_blank" rel="noopener" class="btn btn-primary">
              Google Skills
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href="/chromebookproject" class="btn btn-ghost">
              Terug naar Chromebookproject
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
