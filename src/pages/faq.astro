---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const vragen = [
  {
    categorie: "Studieaanbod",
    v: "Welke richtingen bieden jullie aan?",
    a: "Sint-Victor is een pure ASO-school met een volledig aanbod van de 1ste tot de 3de graad. Bekijk alle richtingen op onze studieaanbod pagina.",
    link: { tekst: "Bekijk het studieaanbod", href: "/studieaanbod" },
  },
  {
    categorie: "Studieaanbod",
    v: "Kan een leerling van richting veranderen?",
    a: "Dit kan enkel indien er nog plaats is in de richting waar men naartoe wenst over te stappen. Neem contact op met het secretariaat om de mogelijkheden te bespreken.",
  },
  {
    categorie: "Schooldag",
    v: "Hoe ziet een schooldag eruit?",
    a: "",
    rooster: {
      graad1en2: [
        { label: "1ste lesuur", tijd: "8.30 – 9.20 uur" },
        { label: "2de lesuur", tijd: "9.20 – 10.10 uur" },
        { label: "Speeltijd", tijd: "10.10 – 10.25 uur", pauze: true },
        { label: "3de lesuur", tijd: "10.25 – 11.15 uur" },
        { label: "4de lesuur", tijd: "11.15 – 12.05 uur" },
        { label: "5de lesuur — middagpauze", tijd: "12.05 – 13.10 uur", pauze: true },
        { label: "6de lesuur", tijd: "13.10 – 14.00 uur" },
        { label: "7de lesuur", tijd: "14.00 – 14.50 uur" },
        { label: "8ste lesuur", tijd: "14.50 – 15.40 uur" },
      ],
      graad3: [
        { label: "1ste lesuur", tijd: "8.30 – 9.20 uur" },
        { label: "2de lesuur", tijd: "9.20 – 10.10 uur" },
        { label: "Speeltijd", tijd: "10.10 – 10.25 uur", pauze: true },
        { label: "3de lesuur", tijd: "10.25 – 11.15 uur" },
        { label: "4de lesuur", tijd: "11.15 – 12.05 uur" },
        { label: "5de lesuur — les", tijd: "12.05 – 12.55 uur" },
        { label: "6de lesuur — middagpauze", tijd: "12.55 – 14.00 uur", pauze: true },
        { label: "7de lesuur", tijd: "14.00 – 14.50 uur" },
        { label: "8ste lesuur", tijd: "14.50 – 15.40 uur" },
      ],
    },
  },
  {
    categorie: "Schooldag",
    v: "Is er toezicht op de speelplaats voor en na school?",
    a: "Ja, de school is open vanaf 8u00 en er is gratis toezicht voorzien van 8u00 tot 16u00.",
  },
  {
    categorie: "Schooldag",
    v: "Voorzien jullie avondstudie na de schooluren?",
    a: "Ja, op maandag, dinsdag en donderdag kunnen leerlingen tussen 16u00 en 17u00 terecht in de avondstudie.",
  },
  {
    categorie: "Communicatie",
    v: "Welk platform gebruikt de school voor communicatie?",
    a: "Alle officiële communicatie verloopt via Smartschool. Ouders en leerlingen vinden er taken, punten, mededelingen en het lesrooster. Inloggen via sv.smartschool.be.",
  },
  {
    categorie: "Communicatie",
    v: "Hoe krijgen ouders informatie over toetsen en taken?",
    a: "Via Smartschool hebben ouders toegang tot het puntenboek en de digitale schoolagenda waar taken en toetsen worden opgegeven.",
  },
  {
    categorie: "Communicatie",
    v: "Hoe worden ouders geïnformeerd bij leermoeilijkheden?",
    a: "Er zijn drie oudercontacten per schooljaar waar rapporten besproken worden. De school neemt ook tussentijds contact op indien nodig.",
  },
  {
    categorie: "Begeleiding",
    v: "Is er een leerlingbegeleider?",
    a: "Ja, de leerlingbegeleider staat in voor ondersteuning bij vragen en/of problemen en werkt nauw samen met de directie en het CLB.",
  },
  {
    categorie: "Regels",
    v: "Wat is het beleid omtrent gsm-gebruik?",
    a: "Gsm's zijn verboden tijdens de schooluren. 's Morgens wordt de gsm in een daarvoor voorzien magnetisch gesloten gsm-zakje gestopt. Op het einde van de schooldag kunnen de zakjes geopend worden bij het naarbuitengaan, via de daarvoor voorziene magnetische sloten.",
  },
  {
    categorie: "Regels",
    v: "Wat zijn de richtlijnen voor afwezigheid?",
    a: "Ouders melden afwezigheid telefonisch vóór 8u30. Een briefje of doktersattest wordt de volgende dag ingediend. Bij ziekte langer dan 3 dagen is een doktersattest verplicht.",
    link: { tekst: "Meer info op de afwezighedenpagina", href: "https://sites.google.com/sintvictor.be/afwezigheden/", extern: true },
  },
  {
    categorie: "Regels",
    v: "Wat is het beleid omtrent pesten?",
    a: "Wij willen dat ieder van jullie zich hier thuis voelt, hier graag is. Daarom zorgen we voor:",
    lijst: [
      "Preventieopdrachten tijdens de les.",
      "Begeleiden en opvolgen van gepeste leerlingen en pesters via gesprekken en herstelgericht handelen.",
      "Sancties bij aanhoudende pesterijen.",
    ],
  },
];

const categorieen = [...new Set(vragen.map(v => v.categorie))];
---
<Layout title="FAQ" description="Veelgestelde vragen over Sint-Victor Alsemberg.">

  <PageHero
    eyebrow="Veelgestelde vragen"
    title="FAQ"
    intro="Antwoorden op de meest gestelde vragen. Staat jouw vraag er niet bij? Contacteer ons."
    width="4xl"
  />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">

      {categorieen.map(cat => (
        <div class="scroll-reveal mb-14">
          <h2 class="text-2xl md:text-3xl font-extrabold text-[#07153b] mb-5">{cat}</h2>
          <div class="divide-y divide-gray-200 border-y border-gray-200">
            {vragen.filter(f => f.categorie === cat).map(faq => (
              <details class="group">
                <summary class="flex items-center justify-between gap-6 py-5 cursor-pointer font-bold text-[#07153b] list-none [&::-webkit-details-marker]:hidden transition-colors duration-150 hover:text-[#13265e]">
                  {faq.v}
                  <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-full border border-gray-200 text-[#07153b] transition-[background-color,border-color] duration-200 group-hover:border-[#07153b]/30 group-open:bg-yellow-400 group-open:border-yellow-400">
                    <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 5v14m7-7H5" />
                    </svg>
                  </span>
                </summary>
                <div class="pb-6 md:pr-14 text-gray-600 text-sm leading-relaxed">
                  {faq.a && <p>{faq.a}</p>}
                  {faq.lijst && (
                    <ul class="mt-3 space-y-2">
                      {faq.lijst.map((item: string) => (
                        <li class="flex items-start gap-2">
                          <span class="mt-1 w-1.5 h-1.5 rounded-full bg-yellow-400 shrink-0"></span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {faq.rooster && (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-2">
                      <div>
                        <div class="text-xs font-extrabold text-[#07153b] uppercase tracking-wide mb-3">1ste & 2de graad</div>
                        <div class="space-y-1">
                          {faq.rooster.graad1en2.map((r: {label: string, tijd: string, pauze?: boolean}) => (
                            <div class={`flex justify-between items-center rounded-lg px-3 py-2 text-xs ${r.pauze ? 'bg-yellow-50 text-yellow-800 font-semibold' : 'bg-gray-50 text-gray-700'}`}>
                              <span>{r.label}</span>
                              <span class="font-mono font-bold">{r.tijd}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                      <div>
                        <div class="text-xs font-extrabold text-[#07153b] uppercase tracking-wide mb-3">3de graad</div>
                        <div class="space-y-1">
                          {faq.rooster.graad3.map((r: {label: string, tijd: string, pauze?: boolean}) => (
                            <div class={`flex justify-between items-center rounded-lg px-3 py-2 text-xs ${r.pauze ? 'bg-yellow-50 text-yellow-800 font-semibold' : 'bg-gray-50 text-gray-700'}`}>
                              <span>{r.label}</span>
                              <span class="font-mono font-bold">{r.tijd}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  )}
                  {faq.link && (
                    <a href={faq.link.href} target={faq.link.extern ? "_blank" : undefined} rel={faq.link.extern ? "noopener" : undefined} class="group/link inline-flex items-center gap-1.5 mt-4 text-[#07153b] font-bold text-sm hover:underline underline-offset-4">
                      {faq.link.tekst}
                      <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                      </svg>
                    </a>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <div class="scroll-reveal mt-4 bg-gray-50 border border-gray-200 rounded-2xl p-6 md:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-gray-600 font-medium">Staat jouw vraag er niet bij?</p>
        <a href="/contact" class="btn btn-navy">
          Neem contact op
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>

    </div>
  </section>

</Layout>
