---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PageCta from '../../components/PageCta.astro';

const richtingen = [
  {
    naam: "Economie-Moderne Talen",
    kleur: "border-green-500 bg-green-50",
    tag: "bg-green-500 text-white",
    beschrijving: "Combinatie van economisch inzicht en sterke talenkennis. Ideaal voor wie zowel cijfers als talen boeit.",
  },
  {
    naam: "Economie-Wiskunde",
    kleur: "border-yellow-400 bg-yellow-50",
    tag: "bg-yellow-400 text-[#07153b]",
    beschrijving: "Economisch denken versterkt met wiskundige vaardigheden. Goede voorbereiding op economische en exacte studies.",
  },
  {
    naam: "Humane Wetenschappen",
    kleur: "border-red-500 bg-red-50",
    tag: "bg-red-500 text-white",
    beschrijving: "Mens, maatschappij en cultuur centraal. Brede vorming in gedragswetenschappen, filosofie en sociale vakken.",
  },
  {
    naam: "Latijn-Moderne Talen",
    kleur: "border-blue-500 bg-blue-50",
    tag: "bg-blue-500 text-white",
    beschrijving: "Klassieke talen gecombineerd met moderne talenkennis. Voor talenliefhebbers met een brede culturele interesse.",
  },
  {
    naam: "Latijn-Wetenschappen",
    kleur: "border-green-600 bg-green-50",
    tag: "bg-green-600 text-white",
    beschrijving: "Klassieke vorming gecombineerd met exacte wetenschappen. Uitstekende voorbereiding op veeleisende universitaire studies.",
  },
  {
    naam: "Moderne Talen-Wetenschappen",
    kleur: "border-yellow-500 bg-yellow-50",
    tag: "bg-yellow-500 text-[#07153b]",
    beschrijving: "Moderne talen en wetenschappen hand in hand. Voor wie talig én wetenschappelijk sterk wil worden.",
  },
  {
    naam: "Wetenschappen-Wiskunde (6u)",
    kleur: "border-red-600 bg-red-50",
    tag: "bg-red-600 text-white",
    beschrijving: "Intensieve wetenschappelijke en wiskundige vorming. Zes uur wiskunde per week als stevige basis.",
  },
  {
    naam: "Wetenschappen-Wiskunde (8u)",
    kleur: "border-blue-700 bg-blue-50",
    tag: "bg-blue-700 text-white",
    beschrijving: "De meest uitdagende wiskundige richting met acht uur wiskunde per week. Ideaal voor wie wil doorstromen naar exacte of technische studies.",
  },
];

const DOC_ID = '13jSdulxxh6gW_lCR1t5OTB60c4CiNZKa';
---
<Layout title="3de graad — Studieaanbod" description="Studieaanbod 3de graad van Sint-Victor Alsemberg: richtingen, lessentabel en meer.">

  <!-- Hero -->
  <PageHero eyebrow="Studieaanbod" title="3de graad" intro="In de derde graad (5de & 6de jaar) verdiepen leerlingen hun ASO-richting en bereiden ze zich voor op het hoger onderwijs." width="5xl">
    <a href="#richtingen" class="btn btn-primary">Richtingen</a>
    <a href="#lessentabel" class="btn btn-ghost">Lessentabel</a>
    <a href="#document" class="btn btn-ghost">Document</a>
  </PageHero>

  <!-- Richtingen -->
  <section id="richtingen" class="py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">

      <div class="scroll-reveal mb-10">
        <span class="eyebrow">ASO-richtingen</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b] mb-4">Studierichtingen</h2>
        <p class="text-gray-600 leading-relaxed max-w-2xl">Alle richtingen zijn ASO met doorstroomfinaliteit naar het hoger onderwijs.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-20">
        {richtingen.map((r, i) => (
          <div class={`scroll-reveal rounded-2xl border-l-4 p-6 ${r.kleur}`} style={`--d:${Math.min(i * 60, 400)}ms`}>
            <span class={`text-xs font-extrabold px-3 py-1 rounded-full inline-block mb-3 ${r.tag}`}>{r.naam}</span>
            <p class="text-gray-600 text-sm leading-relaxed">{r.beschrijving}</p>
          </div>
        ))}
      </div>

      <!-- Lessentabel -->
      <div id="lessentabel" class="mb-20">
        <h3 class="scroll-reveal text-xl md:text-2xl font-extrabold text-[#07153b] mb-5">Lessentabel 3de graad</h3>
        <div class="scroll-reveal rounded-2xl overflow-hidden border border-gray-200 shadow-card" style="--d:80ms">
          <img src="/lessentabellen/3de graad.png" alt="Lessentabel 3de graad" class="w-full h-auto" />
        </div>
      </div>

      <!-- Embedded Drive document -->
      <div id="document">
        <div class="scroll-reveal flex flex-wrap items-end justify-between gap-3 mb-5">
          <h3 class="text-xl md:text-2xl font-extrabold text-[#07153b]">Meer informatie</h3>
          <a href={`https://drive.google.com/file/d/${DOC_ID}/view`} target="_blank" rel="noopener"
            class="text-sm text-[#07153b] font-semibold hover:underline underline-offset-4 inline-flex items-center gap-1.5">
            Openen in Drive
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-card" style="height:700px;">
          <iframe
            src={`https://drive.google.com/file/d/${DOC_ID}/preview`}
            class="w-full h-full"
            allow="autoplay"
            title="Document 3de graad Sint-Victor"
          ></iframe>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <PageCta title="Meer weten over de 3de graad?" intro="Kom langs op onze opendeurdag of neem contact op met ons secretariaat.">
    <a href="/inschrijvingen" class="btn btn-primary">
      Inschrijven
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
    <a href="/contact" class="btn btn-ghost">Contact</a>
    <a href="/studieaanbod" class="btn btn-ghost group">
      <svg class="group-hover:-translate-x-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
      Alle richtingen
    </a>
  </PageCta>

</Layout>
