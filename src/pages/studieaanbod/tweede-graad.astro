---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PageCta from '../../components/PageCta.astro';

const richtingen = [
  {
    naam: "Economische wetenschappen",
    finaliteit: "Economische wetenschappen",
    kleur: "border-green-400 bg-green-50",
    tag: "bg-green-600 text-white",
    beschrijving: "Economie, bedrijfswetenschappen en wiskunde. Voor wie de wereld begrijpt in cijfers en systemen.",
  },
  {
    naam: "Humane wetenschappen",
    finaliteit: "Humane wetenschappen",
    kleur: "border-yellow-400 bg-yellow-50",
    tag: "bg-yellow-500 text-white",
    beschrijving: "Mens en maatschappij centraal. Talenkennis, filosofie en sociale wetenschappen als rode draad.",
  },
  {
    naam: "Latijn",
    finaliteit: "Latijn",
    kleur: "border-red-400 bg-red-50",
    tag: "bg-red-600 text-white",
    beschrijving: "Klassieke talen en cultuur als fundament voor een brede en diepgaande algemene vorming.",
  },
  {
    naam: "Natuurwetenschappen",
    finaliteit: "Natuurwetenschappen",
    kleur: "border-blue-400 bg-blue-50",
    tag: "bg-blue-600 text-white",
    beschrijving: "Exacte wetenschappen: wiskunde, fysica, biologie en chemie. Voor wie houdt van nauwkeurig redeneren.",
  },
];

const DOC_ID = '1yMLVwTePKyvtfJUlTyWS89L969h1cb75';
---
<Layout title="2de graad — Studieaanbod" description="Studieaanbod 2de graad van Sint-Victor Alsemberg: richtingen, lessentabel en meer.">

  <!-- Hero -->
  <PageHero eyebrow="Studieaanbod" title="2de graad" intro="In de tweede graad (3de & 4de jaar) kiezen leerlingen een ASO-studierichting die hen voorbereidt op het hoger onderwijs." width="5xl">
    <a href="#richtingen" class="btn btn-primary">Richtingen</a>
    <a href="#lessentabel" class="btn btn-ghost">Lessentabel</a>
    <a href="#document" class="btn btn-ghost">Document</a>
  </PageHero>

  <!-- Richtingen -->
  <section id="richtingen" class="py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">

      <div class="scroll-reveal mb-10">
        <span class="eyebrow">ASO-richtingen</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b] mb-4">Studierichtingen</h2>
        <p class="text-gray-600 leading-relaxed max-w-2xl">Alle richtingen zijn ASO met doorstroomfinaliteit naar het hoger onderwijs.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-20">
        {richtingen.map((r, i) => (
          <div class={`scroll-reveal rounded-2xl border-l-4 p-5 ${r.kleur}`} style={`--d:${Math.min(i * 60, 400)}ms`}>
            <span class={`text-xs font-extrabold px-3 py-1.5 rounded-full inline-block mb-3 ${r.tag}`}>{r.finaliteit}</span>
            <p class="text-gray-600 text-sm leading-relaxed">{r.beschrijving}</p>
          </div>
        ))}
      </div>

      <!-- Lessentabel -->
      <div id="lessentabel" class="mb-20">
        <h3 class="scroll-reveal text-xl md:text-2xl font-extrabold text-[#07153b] mb-5">Lessentabel 2de graad</h3>
        <div class="scroll-reveal rounded-2xl overflow-hidden border border-gray-200 shadow-card" style="--d:80ms">
          <img src="/lessentabellen/2de graad.png" alt="Lessentabel 2de graad" class="w-full h-auto" />
        </div>
      </div>

      <!-- Embedded Drive document -->
      <div id="document">
        <div class="scroll-reveal flex flex-wrap items-end justify-between gap-3 mb-5">
          <h3 class="text-xl md:text-2xl font-extrabold text-[#07153b]">Meer informatie</h3>
          <a href={`https://drive.google.com/file/d/${DOC_ID}/view`} target="_blank" rel="noopener"
            class="text-sm text-[#07153b] font-semibold hover:underline underline-offset-4 inline-flex items-center gap-1.5">
            Openen in Drive
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-card" style="height:700px;">
          <iframe
            src={`https://drive.google.com/file/d/${DOC_ID}/preview`}
            class="w-full h-full"
            allow="autoplay"
            title="Document 2de graad Sint-Victor"
          ></iframe>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <PageCta title="Meer weten over de 2de graad?" intro="Kom langs op onze opendeurdag of neem contact op met ons secretariaat.">
    <a href="/inschrijvingen" class="btn btn-primary">
      Inschrijven
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
    <a href="/contact" class="btn btn-ghost">Contact</a>
    <a href="/studieaanbod" class="btn btn-ghost group">
      <svg class="group-hover:-translate-x-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
      Alle richtingen
    </a>
  </PageCta>

</Layout>
