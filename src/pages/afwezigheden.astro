---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
const siteUrl = "https://sites.google.com/sintvictor.be/afwezigheden/";
---
<Layout title="Afwezigheid melden" description="Meld de afwezigheid van uw kind bij Sint-Victor Alsemberg.">

  <PageHero eyebrow="Praktisch" title="Afwezigheid melden" intro="Is uw kind ziek of kan het om een andere reden niet naar school? Meld dit via onderstaande link." width="4xl" />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-xl mx-auto text-center">
      <div class="scroll-reveal bg-white rounded-2xl shadow-card border border-gray-200 p-8 md:p-10">
        <div class="bg-[#07153b] rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#07153b] mb-3">Afwezigheid doorgeven</h2>
        <p class="text-gray-600 leading-relaxed mb-8">
          Via onderstaande knop vind je alle informatie en het formulier om een afwezigheid te melden.
        </p>
        <a href={siteUrl} target="_blank" rel="noopener" class="btn btn-navy px-8">
          Afwezigheid melden
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <p class="text-xs text-gray-500 mt-4">Opent in een nieuw tabblad</p>
      </div>
    </div>
  </section>

</Layout>
