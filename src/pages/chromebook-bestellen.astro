---
// Sint-Victor — Digitaal huurovereenkomst-formulier Chromebook
// Last Modified: 2026-06-05
import Layout from '../layouts/Layout.astro';

const GAS_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyIKqpL5AMygtdkDtUuD0VzMklh36Ry46Iz5PL6ze30qL51S4P6MuUqZBxTXQV0KhxtLQ/exec';
const SHARED_SECRET = '81edad35-de30-4d4e-a70b-c53ba23118ca5cfdfb89-6b5d-476e-ad0d-81c21a326340';
---

<Layout title="Chromebook bestellen" description="Digitaal een Chromebook huren bij Sint-Victor Alsemberg — vul het formulier in en onderteken online.">

  <section class="bg-[#07153b] text-white py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-yellow-400 text-xs font-bold uppercase tracking-wide mb-3">Chromebookproject</div>
      <h1 class="text-4xl font-extrabold mb-4">Chromebook huren</h1>
      <p class="text-blue-200 text-lg max-w-2xl">
        Vul het formulier in en onderteken digitaal. U ontvangt het ondertekende contract meteen per e-mail.
      </p>
    </div>
  </section>

  <section class="py-12 px-4">
    <div class="max-w-3xl mx-auto space-y-6">

      <div class="bg-blue-50 border border-blue-100 rounded-2xl px-6 py-5 text-sm text-[#07153b]">
        <div class="font-bold mb-2">Praktisch</div>
        <ul class="list-disc ml-5 space-y-1 text-gray-700">
          <li>Huurprijs: <strong>€ 91,67 per schooljaar</strong> (via gewone schoolfacturen)</li>
          <li>Eenmalige waarborg: <strong>€ 50</strong> (terugbetaald bij schadevrije inlevering)</li>
          <li>Het toestel wordt door de school klaargemaakt en u krijgt bericht voor uitlevering.</li>
        </ul>
      </div>

      <form id="huurForm" class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-5">
        <div>
          <label class="block text-sm font-bold text-[#07153b] mb-1" for="naamOuder">Naam ouder / voogd *</label>
          <input id="naamOuder" name="naamOuder" type="text" required autocomplete="name"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-[#07153b] focus:border-transparent focus:outline-none" />
        </div>

        <div>
          <label class="block text-sm font-bold text-[#07153b] mb-1" for="naamLeerling">Naam leerling *</label>
          <input id="naamLeerling" name="naamLeerling" type="text" required
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-[#07153b] focus:border-transparent focus:outline-none" />
        </div>

        <div>
          <label class="block text-sm font-bold text-[#07153b] mb-1" for="email">E-mailadres ouder *</label>
          <input id="email" name="email" type="email" required autocomplete="email"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-[#07153b] focus:border-transparent focus:outline-none" />
          <p class="text-xs text-gray-500 mt-1">U ontvangt op dit adres een kopie van het ondertekende contract.</p>
        </div>

        <div>
          <label class="block text-sm font-bold text-[#07153b] mb-1">Handtekening *</label>
          <div class="border-2 border-dashed border-gray-300 rounded-lg bg-gray-50 relative">
            <canvas id="sigPad" class="w-full touch-none rounded-lg block" style="height:180px"></canvas>
            <button type="button" id="clearSig"
                    class="absolute top-2 right-2 text-xs text-gray-600 hover:text-red-600 bg-white px-2 py-1 rounded shadow">
              Wissen
            </button>
          </div>
          <p class="text-xs text-gray-500 mt-1">Teken met uw muis of vinger.</p>
        </div>

        <div class="flex items-start gap-3 bg-gray-50 border border-gray-100 rounded-lg p-3">
          <input id="akkoord" type="checkbox" required class="mt-1 w-4 h-4" />
          <label for="akkoord" class="text-sm text-gray-700 leading-relaxed">
            Ik verklaar kennis genomen te hebben van de
            <a href="/Huurovereenkomst-Chromebook-2026-2027.pdf" target="_blank" class="text-[#07153b] font-semibold underline">
              volledige huurovereenkomst</a>
            en ga akkoord met alle bepalingen. *
          </label>
        </div>

        <button type="submit" id="submitBtn"
                class="w-full bg-[#07153b] text-white font-bold py-3 rounded-lg hover:bg-[#0a1d52] disabled:opacity-50 disabled:cursor-not-allowed transition flex items-center justify-center gap-2">
          <span id="submitText">Onderteken en verzend</span>
          <svg id="submitSpinner" class="hidden animate-spin h-5 w-5" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"></circle>
            <path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" class="opacity-75"></path>
          </svg>
        </button>

        <p id="formStatus" class="text-sm text-center"></p>
      </form>

      <div id="successBox" class="hidden bg-green-50 border border-green-200 rounded-2xl p-6 text-center">
        <div class="text-green-600 text-4xl mb-2">✓</div>
        <h2 class="text-xl font-extrabold text-green-800 mb-2">Bedankt!</h2>
        <p class="text-green-900">
          Uw huurovereenkomst is succesvol verzonden. U ontvangt binnen enkele minuten een kopie per e-mail.
        </p>
      </div>

    </div>
  </section>

  <script is:inline define:vars={{ GAS_ENDPOINT, SHARED_SECRET }}>
    const canvas = document.getElementById('sigPad');
    const ctx = canvas.getContext('2d');
    let drawing = false, hasSig = false;

    function fitCanvas() {
      const r = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = r.width * dpr;
      canvas.height = r.height * dpr;
      ctx.scale(dpr, dpr);
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      ctx.strokeStyle = '#111';
    }
    fitCanvas();
    window.addEventListener('resize', fitCanvas);

    function pos(e) {
      const r = canvas.getBoundingClientRect();
      const t = e.touches ? e.touches[0] : e;
      return { x: t.clientX - r.left, y: t.clientY - r.top };
    }
    function start(e) { drawing = true; hasSig = true; const p = pos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); e.preventDefault(); }
    function move(e)  { if (!drawing) return; const p = pos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); e.preventDefault(); }
    function end()    { drawing = false; }

    canvas.addEventListener('mousedown', start);
    canvas.addEventListener('mousemove', move);
    canvas.addEventListener('mouseup', end);
    canvas.addEventListener('mouseleave', end);
    canvas.addEventListener('touchstart', start, { passive: false });
    canvas.addEventListener('touchmove',  move,  { passive: false });
    canvas.addEventListener('touchend',   end);

    document.getElementById('clearSig').addEventListener('click', () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasSig = false;
    });

    const form = document.getElementById('huurForm');
    const btn = document.getElementById('submitBtn');
    const btnText = document.getElementById('submitText');
    const spinner = document.getElementById('submitSpinner');
    const status = document.getElementById('formStatus');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.className = 'text-sm text-center';

      if (!hasSig) {
        status.textContent = 'Gelieve een handtekening te plaatsen.';
        status.classList.add('text-red-600');
        return;
      }

      btn.disabled = true;
      btnText.textContent = 'Bezig met verzenden…';
      spinner.classList.remove('hidden');

      const payload = {
        secret: SHARED_SECRET,
        naamOuder:    document.getElementById('naamOuder').value.trim(),
        naamLeerling: document.getElementById('naamLeerling').value.trim(),
        email:        document.getElementById('email').value.trim(),
        signatureBase64: canvas.toDataURL('image/png'),
        userAgent: navigator.userAgent
      };

      try {
        const res = await fetch(GAS_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
          redirect: 'follow'
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.error || 'onbekende fout');

        form.classList.add('hidden');
        document.getElementById('successBox').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (err) {
        status.textContent = 'Er ging iets fout: ' + err.message + '. Probeer opnieuw of mail admin@sintvictor.be';
        status.classList.add('text-red-600');
        btn.disabled = false;
        btnText.textContent = 'Onderteken en verzend';
        spinner.classList.add('hidden');
      }
    });
  </script>
</Layout>
