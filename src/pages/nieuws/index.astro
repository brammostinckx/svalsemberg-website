---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('nieuws'))
  .filter(i => i.data.gepubliceerd !== false)
  .sort((a, b) => new Date(b.data.datum).getTime() - new Date(a.data.datum).getTime());

function formatDatum(d: string) {
  return new Date(d).toLocaleDateString('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<Layout title="Nieuws" description="Alle nieuwtjes van Sint-Victor Alsemberg.">

  <PageHero eyebrow="Sint-Victor Alsemberg" title="Nieuws" intro="Alle nieuwsberichten van onze school." width="4xl" />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {items.map((item, i) => {
          const href = item.data.internalLink || item.data.link || `/nieuws/${item.id}`;
          const extern = !!item.data.link && !item.data.internalLink;
          return (
            <a href={href} target={extern ? '_blank' : undefined} rel={extern ? 'noopener' : undefined}
              class="scroll-reveal group flex flex-col bg-white rounded-2xl p-7 border border-gray-200 shadow-card transition-[translate,box-shadow,border-color] duration-300 ease-fluid hover:-translate-y-1 hover:shadow-card-hover hover:border-transparent"
              style={`--d:${Math.min(i * 60, 400)}ms`}>
              <div class="flex items-center gap-2 mb-4">
                <span class="bg-yellow-100 text-[#07153b] text-[11px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wide">{item.data.tag}</span>
                <span class="text-gray-500 text-xs">{formatDatum(item.data.datum)}</span>
              </div>
              <h2 class="font-bold text-[#07153b] text-xl leading-snug mb-2">{item.data.titel}</h2>
              <p class="text-gray-500 text-sm leading-relaxed">{item.data.samenvatting}</p>
              <div class="mt-auto pt-6 inline-flex items-center gap-1.5 text-[#07153b] text-sm font-semibold">
                Lees meer
                <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

</Layout>
