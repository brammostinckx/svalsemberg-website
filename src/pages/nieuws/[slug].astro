---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('nieuws');
  return items.map(item => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
const items = await getCollection('nieuws');
const item = items.find(i => i.id === slug);
if (!item || item.data.gepubliceerd === false) return Astro.redirect('/nieuws');

const { Content } = await render(item);

function formatDatum(d: string) {
  return new Date(d).toLocaleDateString('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' });
}

// Leesbare artikeltekst zonder typography-plugin: stijlen voor de gerenderde Markdown.
const artikel = [
  'text-gray-600 text-[1.0625rem] leading-[1.75]',
  '[&>*+*]:mt-5',
  '[&_h2]:font-extrabold [&_h2]:text-[#07153b] [&_h2]:text-2xl md:[&_h2]:text-3xl [&_h2]:leading-tight [&_h2]:mt-12 [&_h2]:mb-4',
  '[&_h3]:font-bold [&_h3]:text-[#07153b] [&_h3]:text-xl [&_h3]:leading-snug [&_h3]:mt-10 [&_h3]:mb-3',
  '[&>h2:first-child]:mt-0 [&>h3:first-child]:mt-0',
  '[&_strong]:font-semibold [&_strong]:text-[#07153b]',
  '[&_a]:font-semibold [&_a]:text-[#07153b] [&_a]:underline [&_a]:decoration-yellow-400 [&_a]:decoration-2 [&_a]:underline-offset-4 [&_a:hover]:decoration-[#07153b]',
  '[&_ul]:list-disc [&_ol]:list-decimal [&_ul]:pl-6 [&_ol]:pl-6 [&_li]:mt-2 [&_li]:pl-1 [&_li::marker]:text-yellow-500',
  '[&_blockquote]:border-l-4 [&_blockquote]:border-yellow-400 [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-gray-700',
  '[&_img]:rounded-2xl [&_img]:border [&_img]:border-gray-200 [&_img]:shadow-card',
  '[&_hr]:my-10 [&_hr]:border-gray-200',
].join(' ');
---
<Layout title={item.data.titel} description={item.data.samenvatting}>

  <PageHero eyebrow={`${item.data.tag} · ${formatDatum(item.data.datum)}`} title={item.data.titel} intro={item.data.samenvatting} width="4xl" />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="max-w-[68ch]">

        <a href="/nieuws" class="group inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-[#07153b] transition-colors mb-10">
          <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
          Alle nieuws
        </a>

        <article class={`scroll-reveal ${artikel}`}>
          <Content />
        </article>

        {item.data.flyer && (
          <div class="mt-12 scroll-reveal">
            {/\.(jpe?g|png|gif|webp)$/i.test(item.data.flyer) ? (
              <img
                src={item.data.flyer}
                alt={`Flyer – ${item.data.titel}`}
                class="w-full rounded-2xl border border-gray-200 shadow-card"
                loading="lazy"
              />
            ) : item.data.flyer.toLowerCase().endsWith('.pdf') ? (
              <div class="border border-gray-200 rounded-2xl overflow-hidden shadow-card">
                <iframe
                  src={item.data.flyer}
                  class="w-full border-0"
                  style="height:700px"
                  title={`Flyer – ${item.data.titel}`}
                ></iframe>
                <div class="px-4 py-3 bg-gray-50 border-t border-gray-200">
                  <a href={item.data.flyer} download
                    class="inline-flex items-center gap-2 text-[#07153b] font-semibold text-sm hover:underline underline-offset-4">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                    Flyer downloaden (PDF)
                  </a>
                </div>
              </div>
            ) : (
              <a href={item.data.flyer} download class="btn btn-outline">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                </svg>
                Bijlage downloaden
              </a>
            )}
          </div>
        )}

        {(item.data.internalLink || item.data.link) && (
          <div class="mt-10">
            <a href={item.data.internalLink || item.data.link}
              target={item.data.link && !item.data.internalLink ? '_blank' : undefined}
              class="btn btn-navy">
              Meer informatie
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
          </div>
        )}

        <div class="mt-14 pt-8 border-t border-gray-200">
          <a href="/nieuws" class="group inline-flex items-center gap-1.5 text-[#07153b] text-sm font-bold">
            <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
            Terug naar nieuws
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
