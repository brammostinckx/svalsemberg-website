---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Vacatures" description="Vacatures bij Sint-Victor Alsemberg.">

  <PageHero eyebrow="Extra" title="Vacatures" intro="Werken bij Sint-Victor Alsemberg." width="4xl" />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-3xl mx-auto">

      <div class="scroll-reveal bg-white border border-gray-200 shadow-card rounded-2xl p-8 md:p-10 text-center mb-8">
        <div class="bg-[#07153b]/10 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-5">
          <svg class="w-8 h-8 text-[#07153b]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-[#07153b] mb-3">Geen openstaande vacatures</h2>
        <p class="text-gray-600 leading-relaxed max-w-md mx-auto">Momenteel zijn er geen openstaande vacatures bij Sint-Victor Alsemberg. Houd deze pagina in de gaten voor toekomstige vacatures.</p>
      </div>

      <div class="scroll-reveal relative isolate overflow-hidden bg-[#07153b] text-white rounded-2xl p-8 md:p-10 text-center" style="--d:100ms">
        <div aria-hidden="true" class="absolute -z-10 -top-24 left-1/3 w-80 h-80 rounded-full bg-blue-500/20 blur-3xl"></div>
        <h2 class="text-2xl font-extrabold mb-2">Spontane sollicitatie</h2>
        <p class="text-blue-100/80 mb-6 max-w-md mx-auto">Ben je geïnteresseerd in een job bij onze school? Stuur gerust een spontane sollicitatie — we houden je kandidatuur bij voor toekomstige vacatures.</p>
        <a href="mailto:solliciteren@sintvictor.be" class="btn btn-primary">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          solliciteren@sintvictor.be
        </a>
      </div>

    </div>
  </section>

</Layout>
