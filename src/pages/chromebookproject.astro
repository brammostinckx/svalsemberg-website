---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const INFOBROCHURE_URL = 'https://docs.google.com/document/d/1SiOvMl0T-tkBZAtKl_6g7KYcRzmjA6t2CbZhlx7Rddg/view';
const BESTELLEN_URL = '/chromebook-bestellen';
const SITE_URL = 'https://sites.google.com/vbsasintvictor.be/gwfe-skills/home';

const pijl = "M13 7l5 5m0 0l-5 5m5-5H6";
const extern = "M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14";

const links = [
  { icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z", label: "Chromebook opstarten & instellen", href: "/chromebook-opstart" },
  { icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z", label: "Aanmelden op je Chromebook", href: "/chromebook-aanmelden" },
  { icon: "M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z", label: "Google Drive, Docs, Slides & Sheets", href: "https://sites.google.com/vbsasintvictor.be/gwfe-skills/home", extern: true },
  { icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253", label: "Google Classroom & Gmail", href: "/google-diensten" },
  { icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z", label: "Essentiële shortcuts", href: "/chromebook-shortcuts" },
  { icon: "M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z", label: "Problemen met de Chromebook?", href: "/chromebook-problemen" },
];
---
<Layout title="Chromebookproject" description="Alles over het Chromebookproject van Sint-Victor Alsemberg.">

  <PageHero
    eyebrow="Extra"
    title="Chromebookproject"
    intro="Sint-Victor Alsemberg werkt met Chromebooks en Google Workspace. Hier vind je alle info over het bestellen, instellen en gebruiken van je toestel."
    width="4xl"
  />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">

      <!-- Drie hoofdacties -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-16 md:mb-24">

        <!-- Infobrochure -->
        <a href={INFOBROCHURE_URL} target="_blank" rel="noopener"
          class="scroll-reveal group bg-white rounded-2xl border border-gray-200 shadow-card p-7 flex flex-col transition-[translate,box-shadow,border-color] duration-300 ease-fluid hover:-translate-y-1 hover:shadow-card-hover hover:border-transparent">
          <div class="bg-[#07153b]/[0.06] group-hover:bg-[#07153b] rounded-xl w-12 h-12 flex items-center justify-center mb-6 transition-colors duration-200">
            <svg class="w-6 h-6 text-[#07153b] group-hover:text-yellow-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="font-bold text-[#07153b] text-lg mb-2">Infobrochure Chromebooks</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Lees alles over het Chromebookproject: wat, waarom en hoe.</p>
          <span class="mt-auto pt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-[#07153b]">
            Bekijk document
            <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={pijl}/></svg>
          </span>
        </a>

        <!-- Bestellen -->
        <a href={BESTELLEN_URL}
          class="scroll-reveal group bg-yellow-400 rounded-2xl p-7 flex flex-col transition-[translate,box-shadow] duration-300 ease-fluid hover:-translate-y-1 hover:shadow-card-hover" style="--d:80ms">
          <div class="bg-[#07153b] rounded-xl w-12 h-12 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="font-bold text-[#07153b] text-lg mb-2">Chromebook bestellen</h3>
          <p class="text-[#07153b]/80 text-sm leading-relaxed">Bestel je Chromebook via dit bestelformulier.</p>
          <span class="mt-auto pt-6 inline-flex items-center gap-1.5 text-sm font-bold text-[#07153b]">
            Naar bestelformulier
            <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={pijl}/></svg>
          </span>
        </a>

        <!-- Handleidingen & site -->
        <a href={SITE_URL} target="_blank" rel="noopener"
          class="scroll-reveal group bg-white rounded-2xl border border-gray-200 shadow-card p-7 flex flex-col transition-[translate,box-shadow,border-color] duration-300 ease-fluid hover:-translate-y-1 hover:shadow-card-hover hover:border-transparent" style="--d:160ms">
          <div class="bg-[#07153b]/[0.06] group-hover:bg-[#07153b] rounded-xl w-12 h-12 flex items-center justify-center mb-6 transition-colors duration-200">
            <svg class="w-6 h-6 text-[#07153b] group-hover:text-yellow-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-bold text-[#07153b] text-lg mb-2">Google Skills</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Leer werken met Google Workspace via onze handleidingen en tutorials.</p>
          <span class="mt-auto pt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-[#07153b]">
            Bekijk de site
            <svg class="w-4 h-4 transition-transform duration-200 ease-fluid group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={pijl}/></svg>
          </span>
        </a>

      </div>

      <!-- Wat is het project -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-16 md:mb-24">
        <div class="md:col-span-5 scroll-reveal">
          <span class="eyebrow">Over het project</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b] leading-[1.08]">Wat is het Chromebookproject?</h2>
        </div>
        <div class="md:col-span-7 space-y-4 text-gray-600 leading-relaxed scroll-reveal" style="--d:80ms">
          <p>Sint-Victor Alsemberg werkt volledig digitaal met <strong class="text-[#07153b]">Chromebooks en Google Workspace for Education</strong>. Elke leerling beschikt over een eigen toestel dat thuis en op school gebruikt wordt.</p>
          <p>Chromebooks zijn licht, snel en veilig. Ze bieden toegang tot alle digitale leermiddelen: Google Classroom, Drive, Docs, Slides en meer — allemaal via het schoolaccount.</p>
        </div>
      </div>

      <!-- Wat zit erin -->
      <div class="mb-16 md:mb-24">
        <div class="scroll-reveal">
          <span class="eyebrow">Handleidingen</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#07153b] mb-8">Wat vind je op de site terug?</h2>
        </div>
        <ul class="scroll-reveal bg-white rounded-2xl border border-gray-100 shadow-card divide-y divide-gray-100 overflow-hidden" style="--d:80ms">
          {links.map(item => (
            <li>
              <a href={item.href} target={item.extern ? "_blank" : undefined} rel={item.extern ? "noopener" : undefined}
                class="group flex items-center gap-4 px-5 sm:px-6 py-4 transition-colors duration-150 hover:bg-gray-50">
                <span class="bg-[#07153b]/[0.06] group-hover:bg-[#07153b] rounded-lg w-9 h-9 flex items-center justify-center shrink-0 transition-colors duration-200">
                  <svg class="w-4 h-4 text-[#07153b] group-hover:text-yellow-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
                  </svg>
                </span>
                <span class="font-medium text-gray-700 group-hover:text-[#07153b] transition-colors">{item.label}</span>
                {item.extern ? (
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-[#07153b] ml-auto shrink-0 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={extern}/>
                  </svg>
                ) : (
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-[#07153b] ml-auto shrink-0 transition-[color,translate] duration-200 ease-fluid group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="scroll-reveal relative isolate overflow-hidden bg-[#07153b] text-white rounded-2xl p-8 md:p-10 grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
        <div aria-hidden="true" class="absolute -z-10 -top-24 -right-16 w-72 h-72 rounded-full bg-blue-500/20 blur-3xl"></div>
        <div class="md:col-span-7">
          <h2 class="text-2xl font-extrabold mb-2">Vragen over het Chromebookproject?</h2>
          <p class="text-blue-100/80">Neem contact op met het secretariaat of raadpleeg de handleidingen op de projectsite.</p>
        </div>
        <div class="md:col-span-5 flex flex-wrap md:justify-end gap-3">
          <a href={INFOBROCHURE_URL} target="_blank" rel="noopener" class="btn btn-primary">
            Infobrochure
          </a>
          <a href="/contact" class="btn btn-ghost">
            Contact opnemen
          </a>
        </div>
      </div>

    </div>
  </section>

</Layout>
