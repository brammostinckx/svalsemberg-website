---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Sint-Victor Alsemberg — secundair onderwijs met hart voor elke leerling" } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [
  { label: "Start", href: "/" },
  { label: "Onze school", href: "/onze-school", sub: [
    { label: "Visie & missie", href: "/onze-school" },
    { label: "Schoolreglement", href: "/schoolreglement" },
  ]},
  { label: "Studieaanbod", href: "/studieaanbod", sub: [
    { label: "1ste graad", href: "/studieaanbod/eerste-graad" },
    { label: "2de graad", href: "/studieaanbod/tweede-graad" },
    { label: "3de graad", href: "/studieaanbod/derde-graad" },
  ]},
  { label: "FAQ", href: "/faq" },
  { label: "Extra", href: "/extra", sub: [
    { label: "Chromebookproject", href: "/chromebookproject" },
    { label: "SV-Tamtam", href: "/sv-tamtam" },
    { label: "AED-project", href: "/aed-project" },
    { label: "Vacatures", href: "/vacatures" },
    { label: "Sint-Victor Strava", href: "/strava" },
  ]},
  { label: "Contact", href: "/contact" },
];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Geist:wght@400..700&display=swap" rel="stylesheet" />
    <title>{title} | Sint-Victor Alsemberg</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="bg-white text-gray-800 font-sans">

    <!-- Topbalk -->
    <div class="bg-[#07153b] text-white/80 text-xs py-2 px-4 hidden md:flex">
      <div class="max-w-6xl mx-auto w-full flex justify-between items-center">
        <div class="flex items-center gap-6">
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Brusselsesteenweg 20, 1652 Alsemberg
          </span>
          <a href="mailto:info@sintvictor.be" class="hover:text-yellow-300 transition flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            info@sintvictor.be
          </a>
          <a href="tel:+3223801589" class="hover:text-yellow-300 transition flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            02 380 15 89
          </a>
        </div>
        <div class="flex items-center gap-4">
          <a href="https://sv.smartschool.be" target="_blank" rel="noopener" class="hover:text-yellow-300 transition">Smartschool</a>
          <span class="text-blue-400">|</span>
          <a href="https://sites.google.com/sintvictor.be/afwezigheden/" target="_blank" rel="noopener" class="hover:text-yellow-300 transition">Afwezigheid melden</a>
        </div>
      </div>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white border-b border-gray-200/80">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 transition-opacity duration-200 hover:opacity-80">
          <img src="/logo-cropped.png" alt="Sint-Victor Alsemberg" class="h-12 w-auto" />
        </a>

        <nav class="hidden lg:flex items-center gap-1" aria-label="Hoofdmenu">
          {nav.map(item => {
            const actief = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) || item.sub?.some(s => currentPath === s.href);
            return (
              <div class="relative group">
                <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}
                  class={`relative px-3 py-2 rounded-lg font-semibold text-sm transition-colors duration-200 flex items-center gap-1 ${actief ? 'text-[#07153b]' : 'text-gray-600 hover:text-[#07153b] hover:bg-gray-100/80'}`}>
                  {item.label}
                  {item.sub && item.sub.length > 0 && (
                    <svg class="w-3 h-3 text-gray-400 transition-transform duration-200 ease-fluid group-hover:rotate-180 group-hover:text-[#07153b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  )}
                  {actief && <span class="absolute left-3 right-3 -bottom-[13px] h-0.5 rounded-full bg-yellow-400"></span>}
                </a>
                {item.sub && item.sub.length > 0 && (
                  <div class="absolute top-full left-0 pt-2 z-50 invisible opacity-0 -translate-y-1 scale-[0.98] origin-top-left transition-[opacity,translate,scale,visibility] duration-200 ease-fluid group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:scale-100">
                    <div class="bg-white rounded-xl shadow-card-hover border border-gray-100 p-1.5 min-w-56">
                      {item.sub.map(s => (
                        <a href={s.href} class={`block px-3 py-2 rounded-lg text-sm transition-colors duration-150 ${currentPath === s.href ? 'text-[#07153b] font-semibold bg-gray-50' : 'text-gray-600 hover:text-[#07153b] hover:bg-gray-50'}`}>{s.label}</a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            );
          })}
          <a href="/inschrijvingen" class="group ml-3 inline-flex items-center gap-1.5 bg-yellow-400 text-[#07153b] font-bold text-sm px-4 py-2 rounded-lg hover:bg-yellow-300 transition-[background-color,scale] duration-150">
            Inschrijven
            <svg class="w-3.5 h-3.5 transition-transform duration-200 ease-fluid group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </nav>

        <button id="menu-toggle" class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu openen">
          <svg class="w-6 h-6 text-[#07153b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <div id="mobile-menu" class="mobile-menu hidden lg:hidden border-t border-gray-100 px-4 pt-2 pb-4 bg-white max-h-[calc(100dvh-4.5rem)] overflow-y-auto">
        <nav class="divide-y divide-gray-100" aria-label="Mobiel menu">
          {nav.map(item => (
            <div class="py-1">
              <a href={item.href} class={`block px-2 py-2.5 text-base font-semibold transition-colors ${currentPath === item.href ? 'text-[#07153b]' : 'text-gray-700'}`}>{item.label}</a>
              {item.sub && item.sub.length > 0 && (
                <div class="pl-2 pb-1.5 flex flex-wrap gap-1.5">
                  {item.sub.map(s => (
                    <a href={s.href} class={`text-sm px-3 py-1.5 rounded-lg ${currentPath === s.href ? 'bg-[#07153b] text-white' : 'bg-gray-100 text-gray-600'}`}>{s.label}</a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </nav>
        <a href="/inschrijvingen" class="block mt-3 bg-yellow-400 text-[#07153b] font-bold text-sm px-4 py-3 rounded-xl text-center">Inschrijven</a>
        <div class="mt-3 grid grid-cols-2 gap-2 text-sm">
          <a href="https://sv.smartschool.be" target="_blank" rel="noopener" class="text-center px-3 py-2.5 rounded-xl border border-gray-200 text-gray-700 font-medium">Smartschool</a>
          <a href="https://sites.google.com/sintvictor.be/afwezigheden/" target="_blank" rel="noopener" class="text-center px-3 py-2.5 rounded-xl border border-gray-200 text-gray-700 font-medium">Afwezigheid melden</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-[#07153b] text-white mt-0 px-4">
      <div class="max-w-6xl mx-auto py-12 border-t border-white/10 grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            <img src="/logosvaWit.png" alt="Sint-Victor Alsemberg" class="h-20 w-auto" />
          </div>
          <p class="text-blue-200 text-sm leading-relaxed max-w-xs mb-4">
            "Honor Deo, Labor mihi, Utilitas proximo" — een katholieke school met meer dan 150 jaar traditie.
          </p>
          <div class="flex gap-3 flex-wrap">
            <a href="https://instagram.com/sintvictor" target="_blank" rel="noopener"
              class="bg-white/10 hover:bg-white/20 transition px-3 py-1 rounded-lg text-xs font-medium">Instagram</a>
            <a href="https://facebook.com/sintvictor" target="_blank" rel="noopener"
              class="bg-white/10 hover:bg-white/20 transition px-3 py-1 rounded-lg text-xs font-medium">Facebook</a>
            <a href="https://www.youtube.com/@SintVictorAlsemberg" target="_blank" rel="noopener"
              class="bg-white/10 hover:bg-white/20 transition px-3 py-1 rounded-lg text-xs font-medium">YouTube</a>
            <a href="https://sv.smartschool.be" target="_blank" rel="noopener"
              class="bg-white/10 hover:bg-white/20 transition px-3 py-1 rounded-lg text-xs font-medium">Smartschool</a>
          </div>
        </div>
        <div>
          <div class="font-bold mb-3 text-yellow-400 text-sm uppercase tracking-wide">Navigatie</div>
          <ul class="space-y-2 text-sm text-blue-200">
            <li><a href="/onze-school" class="hover:text-white transition">Onze school</a></li>
            <li><a href="/studieaanbod" class="hover:text-white transition">Studieaanbod</a></li>
            <li><a href="/inschrijvingen" class="hover:text-white transition">Inschrijvingen</a></li>
            <li><a href="/sv-tamtam" class="hover:text-white transition">SV-Tamtam</a></li>
            <li><a href="/schoolreglement" class="hover:text-white transition">Schoolreglement</a></li>
            <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
            <li><a href="/contact" class="hover:text-white transition">Contact</a></li>
          </ul>
        </div>
        <div>
          <div class="font-bold mb-3 text-yellow-400 text-sm uppercase tracking-wide">Contact</div>
          <ul class="space-y-2 text-sm text-blue-200">
            <li>Brusselsesteenweg 20</li>
            <li>1652 Alsemberg</li>
            <li class="pt-1"><a href="tel:+3223801589" class="hover:text-white transition">02/380.15.89</a></li>
            <li><a href="mailto:info@sintvictor.be" class="hover:text-white transition">info@sintvictor.be</a></li>
            <li class="pt-1 text-xs">
              <span class="block font-medium text-white">Directie 1ste graad:</span>
              Nele Neyt
            </li>
            <li class="text-xs">
              <span class="block font-medium text-white">Directie 2de &amp; 3de graad:</span>
              Kevin Swaelens
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10 text-center text-blue-300/70 text-xs py-5">
        © {new Date().getFullYear()} Sint-Victor Alsemberg
      </div>
    </footer>

    <style is:global>
      .mobile-menu:not(.hidden) {
        animation: sv-menu-in 240ms var(--ease-fluid) both;
      }
      @keyframes sv-menu-in {
        from { opacity: 0; transform: translateY(-6px); }
      }
    </style>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });

      document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
